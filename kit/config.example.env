# vpn-deploy-kit 配置文件
# 复制为 config.env 后编辑: cp config.example.env config.env

# === VPS 连接 ===
VPS_IP=             # 必填: VPS 公网 IP
SSH_PORT=22         # 当前 SSH 端口
SSH_NEW_PORT=22022  # 加固后的新 SSH 端口
SSH_PUBKEY=         # 本地公钥内容 (ssh-ed25519 AAAA...)，01-harden-ssh 写入 authorized_keys
SSH_KEY_PATH=~/.ssh/id_ed25519  # 本地私钥路径 (用于连接提示)

# === Hysteria2 ===
HY2_PORT=           # 留空由 02-port-probe 决定，或手动指定
HY2_SNI=www.microsoft.com
HY2_MASQUERADE=https://www.bing.com
HY2_VERSION=app/v2.6.0   # GitHub release tag，pin 版本防供应链
HY2_SHA256=        # 留空跳过校验 (warn)，或填入对应版本 SHA256

# === Reality (Batch 2) ===
XUI_VERSION_PIN=v2.9.4  # 实测 2026-05-20:MHSanaei/3x-ui latest stable;v3.0.x 当时还是 prerelease。GA 后需重新评估 API 兼容性
PANEL_PORT=2053
PANEL_PATH=         # 留空自动生成 16 字符随机串
PANEL_USER=         # 留空自动生成
PANEL_PASS=         # 留空自动生成
REALITY_PORT=       # 留空由 02-port-probe 决定
REALITY_SNI=addons.mozilla.org  # dest+serverNames。必须支持后量子 X25519MLKEM768，否则 Chrome 指纹 ClientHello 触发 HRR、xray 26.x Reality 借证书接管失败握手 EOF。换值前先 openssl s_client -groups X25519MLKEM768 -connect <dest>:443 验证(需 openssl≥3.5，handshake_failure=不支持)。避开 apple/icloud(xray 自警可能被 block)。降级链 → dl.google.com

# === 客户端 ===
CLIENT_NAME_PREFIX=us

# === 运行模式 ===
BOOTSTRAP_FORCE=0   # 1=跳过预检
BOOTSTRAP_DRY_RUN=0 # 1=只打印命令不执行
